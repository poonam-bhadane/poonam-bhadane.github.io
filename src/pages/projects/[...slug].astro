---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { site } from '../../config';

export async function getStaticPaths() {
  // Tiles marked directLink open the demo directly, so they get no project page.
  const projects = await getCollection('projects', ({ data }) => !(data.directLink && data.live));
  return projects.map((project) => ({ params: { slug: project.id }, props: { project } }));
}

const { project } = Astro.props;
const { Content } = await render(project);
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const labels = { live: 'Live', prototype: 'Working prototype', design: 'Design and documentation' } as const;
const d = project.data;
const repoUrl = site.githubUser && d.repo ? `https://github.com/${site.githubUser}/${d.repo}` : '';
const liveUrl = d.live ? (d.live.startsWith('/') ? `${base}${d.live}` : d.live) : '';
---
<Base title={d.title} description={d.summary}>
  <main class="wrap narrow page">
    <a class="back" href={`${base}/#projects`}>← All projects</a>
    <span class={`status ${d.status}`}>{labels[d.status]}</span>
    <h1 style="margin-top:10px">{d.title}</h1>
    <p class="lead">{d.summary}</p>
    <div class="tags" style="margin-bottom:14px">{d.tags.map((t) => <span class="tag">{t}</span>)}</div>
    <div class="actions" style="margin-bottom:24px">
      {liveUrl && <a class="btn primary" href={liveUrl} target="_blank" rel="noopener">{d.liveLabel} ↗</a>}
      {repoUrl && <a class="btn" href={repoUrl} target="_blank" rel="noopener">View code on GitHub ↗</a>}
    </div>
    <div class="prose"><Content /></div>
  </main>
</Base>
