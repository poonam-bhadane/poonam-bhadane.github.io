---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
---
<Base title="Blog" description="Notes on what I am building and learning.">
  <main class="wrap narrow page">
    <a class="back" href={`${base}/`}>← Home</a>
    <h1>Blog</h1>
    <p class="lead">Notes on what I am building and learning.</p>
    {posts.length === 0
      ? <p>No posts yet.</p>
      : <div class="postlist">
          {posts.map((post) => (
            <a class="card" href={`${base}/blog/${post.id}`}>
              <h3>{post.data.title}</h3>
              <p>{post.data.description}</p>
              <span class="meta">{post.data.pubDate.toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' })}</span>
              <div class="tags">{post.data.tags.map((t) => <span class="tag">{t}</span>)}</div>
            </a>
          ))}
        </div>}
  </main>
</Base>
